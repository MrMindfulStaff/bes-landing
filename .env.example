# ─────────────────────────────────────────────────────────────
# BES Platform — environment variables
# Copy to .env.local for local dev. Set the same keys in Vercel.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable (anon) key — safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
# Server-only. NEVER expose to the browser. Used by /api/engine/*, the mentor
# personas and admin tasks.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Anthropic — BES AI concierge (/api/concierge) and the mentor personas
ANTHROPIC_API_KEY=sk-ant-xxx

# Shared secret callers send to /api/engine/* (Authorization: Bearer or x-engine-key)
ENGINE_API_KEY=generate-a-long-random-string
# Optional. Profile id engine posts are authored by; defaults to the first admin.
# ENGINE_AUTHOR_ID=

# Secret Vercel Cron sends as a Bearer token to /api/cron/personas
CRON_SECRET=generate-a-long-random-string

# Resend — admin broadcast emails. Without RESEND_API_KEY a broadcast still
# posts and notifies in-app, but the email is skipped.
# RESEND_API_KEY=re_xxx
# BROADCAST_FROM=The Black Entrepreneurship Society <team@jointhebes.com>
# Optional. Hours between broadcasts (default 72).
# BROADCAST_COOLDOWN_HOURS=72
