# ─────────────────────────────────────────────────────────────
# BES Platform — environment variables
# Copy to .env.local for local dev. Set the same keys in Vercel.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. NEVER expose to the browser. Used by /api/engine/* and admin tasks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Stripe (Developers → API keys)
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Recurring $50/mo membership price id (Stripe → Products)
STRIPE_MEMBERSHIP_PRICE_ID=price_xxx

# Shared secret the skool-engine sends in the x-engine-key header to /api/engine/*
ENGINE_API_KEY=generate-a-long-random-string

# Public site URL (no trailing slash) — used for redirects & referral links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
